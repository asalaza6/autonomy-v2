{
  "integrationBranch": "dev",
  "productionBranch": "main",
  "blockedBranches": ["main", "master"],
  "branchPrefixes": {
    "task": "agent",
    "resolve": "resolve"
  },
  "mergeActors": ["reviewer"],
  "worktreesRoot": ".autonomy/worktrees",
  "mergeStrategy": "merge",
  "agents": [
    {
      "id": "pm-agent",
      "personaName": "pm-agent",
      "role": "pm",
      "systemPrompt": "prompts/autonomous/v2/agents/pm-agent/system.md",
      "gitIdentity": {
        "name": "fluxborne-pm[bot]",
        "email": "fluxborne-pm[bot]@users.noreply.github.com"
      },
      "prLabels": ["agent:pm"]
    },
    {
      "id": "aquarium-agent",
      "personaName": "aquarium-agent",
      "role": "implementation",
      "runnerCommand": ["node", "scripts/autonomy-v2-default-runner.js"],
      "taskQueue": "prompts/autonomous/v2/state/queues/aquarium-agent.json",
      "systemPrompt": "prompts/autonomous/v2/agents/aquarium-agent/system.md",
      "gitIdentity": {
        "name": "fluxborne-aquarium[bot]",
        "email": "fluxborne-aquarium[bot]@users.noreply.github.com"
      },
      "prLabels": ["agent:aquarium"],
      "include": [
        "src/barebones-starter/games/apps/aquarium/**"
      ],
      "checks": ["npm run typecheck"]
    },
    {
      "id": "adventure-agent",
      "personaName": "adventure-agent",
      "role": "implementation",
      "runnerCommand": ["node", "scripts/autonomy-v2-default-runner.js"],
      "taskQueue": "prompts/autonomous/v2/state/queues/adventure-agent.json",
      "systemPrompt": "prompts/autonomous/v2/agents/adventure-agent/system.md",
      "gitIdentity": {
        "name": "fluxborne-adventure[bot]",
        "email": "fluxborne-adventure[bot]@users.noreply.github.com"
      },
      "prLabels": ["agent:adventure"],
      "include": [
        "src/barebones-starter/games/apps/adventure/**"
      ],
      "checks": ["npm run typecheck"]
    },
    {
      "id": "action-agent",
      "personaName": "action-agent",
      "role": "implementation",
      "runnerCommand": ["node", "scripts/autonomy-v2-default-runner.js"],
      "taskQueue": "prompts/autonomous/v2/state/queues/action-agent.json",
      "systemPrompt": "prompts/autonomous/v2/agents/action-agent/system.md",
      "gitIdentity": {
        "name": "fluxborne-action[bot]",
        "email": "fluxborne-action[bot]@users.noreply.github.com"
      },
      "prLabels": ["agent:action"],
      "include": [
        "src/barebones-starter/games/apps/fluxborne/**"
      ],
      "checks": ["npm run typecheck"]
    },
    {
      "id": "reviewer",
      "personaName": "reviewer-agent",
      "role": "review",
      "runnerCommand": ["node", "scripts/autonomy-v2-default-runner.js"],
      "taskQueue": "prompts/autonomous/v2/state/queues/reviewer.json",
      "systemPrompt": "prompts/autonomous/v2/agents/reviewer/system.md",
      "gitIdentity": {
        "name": "fluxborne-reviewer[bot]",
        "email": "fluxborne-reviewer[bot]@users.noreply.github.com"
      },
      "commentSignature": "reviewer-agent"
    }
  ]
}
