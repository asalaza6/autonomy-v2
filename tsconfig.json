{
  "compilerOptions": {
    "allowJs": false,
    "jsx": "react-jsx",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "strict": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "declaration": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "bin/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "control-presets/**/*.ts",
    "control-presets/**/*.tsx",
    "presets/**/*.ts"
  ]
}
