{
  "name": "@asalaza6/autonomy-v2",
  "version": "1.4.15",
  "description": "Autonomy v2 orchestration package.",
  "type": "commonjs",
  "private": false,
  "author": "Autonomy V2",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asalaza6/autonomy-v2.git"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "autonomy",
    "agent-system"
  ],
  "main": "src/autonomy-v2/index.js",
  "bin": {
    "autonomy-v2": "bin/autonomy-v2",
    "autonomy-v2-server": "bin/autonomy-v2-server",
    "autonomy-v2-smoke": "bin/autonomy-v2-smoke"
  },
  "exports": {
    ".": "./src/autonomy-v2/index.js",
    "./server": "./src/server/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "smoke": "node --test tests/smoke/package-smoke.test.js",
    "lint": "eslint src tests",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "node scripts/typecheck.js",
    "circular": "npx -y madge --circular --extensions js src",
    "release:patch": "npm run smoke && npm version patch && npm publish --access public",
    "release:minor": "npm run smoke && npm version minor && npm publish --access public",
    "release:major": "npm run smoke && npm version major && npm publish --access public",
    "release:tag": "npm run smoke && npm publish --access public --tag ${npm_config_tag:-latest}"
  },
  "files": [
    "README.md",
    "bin",
    "src",
    "templates",
    "tests"
  ],
  "devDependencies": {
    "eslint": "^10.1.0",
    "globals": "^17.4.0"
  }
}
