{
  "name": "@asalaza6/autonomy-v2",
  "version": "2.0.1",
  "description": "A minimal server for repository-defined custom agents.",
  "type": "module",
  "private": false,
  "author": "Autonomy V2",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asalaza6/autonomy-v2.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "autonomy",
    "custom-agents"
  ],
  "main": "./dist/src/autonomy-v2/index.js",
  "types": "./dist/src/autonomy-v2/index.d.ts",
  "bin": {
    "autonomy-v2": "dist/bin/autonomy-v2.js",
    "autonomy-v2-server": "dist/bin/autonomy-v2-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/autonomy-v2/index.d.ts",
      "import": "./dist/src/autonomy-v2/index.js"
    },
    "./server": {
      "types": "./dist/src/server/server-main.d.ts",
      "import": "./dist/src/server/server-main.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "lint": "eslint src bin tests",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/bin",
    "dist/src"
  ],
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.4.0",
    "typescript": "^5.9.3"
  }
}
