{
  "$schema": "https://unpkg.com/knip/schema.json",
  "entry": [
    "src/frontend/action-worker.ts",
    "src/server/custom-agents/custom-agent-worker.ts",
    "bin/*.ts",
    "presets/*/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "bin/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.js",
    "presets/**/*.mjs"
  ],
  "ignoreBinaries": [
    "osascript"
  ]
}
