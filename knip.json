{
  "$schema": "https://unpkg.com/knip/schema.json",
  "entry": [
    "src/frontend/action-worker.ts",
    "src/server/custom-agents/custom-agent-worker.ts",
    "bin/*.ts",
    "presets/*/*.mjs",
    "control-presets/*/actions.ts",
    "control-presets/*/frontend.tsx",
    "control-presets/**/tests/*.test.tsx"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "bin/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.js",
    "presets/**/*.mjs",
    "control-presets/**/*.{ts,tsx}"
  ],
  "ignoreBinaries": [
    "osascript"
  ]
}
